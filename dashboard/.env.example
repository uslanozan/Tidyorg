# ─── GitHub OAuth App (Device Flow) ──────────────────────────────────────────
# Ozan'ın Faz 4'te oluşturacağı OAuth App'in client_id'si.
# "Enable Device Flow" işaretli olmalı. client_secret GEREKMEZ — bu yüzden
# değeri repoya commit'lemek güvenlik açığı değildir, yine de .env'de tutulur.
VITE_GITHUB_CLIENT_ID=

# ─── Config repo'su ──────────────────────────────────────────────────────────
# Dashboard'un okuyup PR açtığı repo.
VITE_CONFIG_OWNER=your-org
VITE_CONFIG_REPO=Tidyorg
VITE_CONFIG_BRANCH=main

# ─── OAuth proxy yolu ────────────────────────────────────────────────────────
# Boş bırakılırsa /gh-oauth kullanılır (dev'de Vite proxy'si, prod'da hosting
# rewrite'ı karşılar). Kendi proxy'ni kullanacaksan tam URL yaz.
VITE_OAUTH_PROXY=
