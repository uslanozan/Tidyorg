# ─── Terraform ───────────────────────────────────────────
# Local .terraform directory (provider binaries, modules cache)
.terraform/

# State files — managed by HCP Terraform Cloud, never commit locally
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files with secrets — use *.tfvars.example instead
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files (local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output (binary, not human-readable)
*.tfplan
tfplan

# ─── IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Secrets & Local Config ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
