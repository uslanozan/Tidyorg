ozan/

# ─── Terraform ───────────────────────────────────────────
# Local .terraform directory (provider binaries, modules cache)
.terraform/

# State files — managed by HCP Terraform Cloud, never commit locally
*.tfstate
*.tfstate.*
*.tfstate.backup

# Variable files with secrets — use *.tfvars.example instead
*.tfvars
!*.tfvars.example

# Crash logs
crash.log
crash.*.log

# Override files (local-only overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan output (binary, not human-readable)
*.tfplan
tfplan

# ─── Dashboard (Node / Vite) ─────────────────────────────
# dashboard/.gitignore de aynısını kapsıyor; burada durması, kökten çalışan
# araçların (grep, arşivleme, CI cache) da bu dizinleri atlaması içindir.
node_modules/
dashboard/dist/
dashboard/.env
dashboard/.env.*
!dashboard/.env.example

# ─── IDE ─────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Secrets & Local Config ──────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── Docker runtime mounts (docker-compose bind-mount targets) ───
# Root-anchored so terraform/config/ and config.example/ are NOT ignored.
# These hold the operator's REAL private config, local tfstate and App key —
# never source, never committed.
/config/
/state/
